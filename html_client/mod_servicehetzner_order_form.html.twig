{% set cfg = product.config|default({}) %}

<h5 class="mb-2">{{ product.title }}</h5>
<p class="text-muted mb-3">{{ 'Configure your Hetzner VPS options before adding to cart.'|trans }}</p>

{% set billing_mode = cfg.billing_mode|default('standard') %}

<input type="hidden" name="project_ref" value="{{ cfg.project_ref|default('') }}">
<input type="hidden" name="datacenter" value="{{ cfg.datacenter|default('') }}">
<input type="hidden" name="ssh_keys" value="{{ cfg.ssh_keys|default('') }}">
<input type="hidden" name="billing_mode" value="{{ billing_mode }}">

<div class="row g-3">
  <div class="col-12">
    <label class="form-label">{{ 'Server type'|trans }}</label>
    {% if cfg.allow_server_type_choice|default('0') in ['1', 1, true] %}
      <input type="hidden" id="order_hetzner_server_type" name="server_type" value="{{ cfg.server_type|default('') }}">
      <div id="order_hetzner_server_type_buttons" class="d-flex flex-column gap-2">
        <div class="small text-muted">{{ 'Loading server types...'|trans }}</div>
      </div>
      <small class="form-hint">{{ 'Available servers for selected category are shown below. Inactive servers are unavailable for current location.'|trans }}</small>
      <small class="form-hint">{{ 'Required. Choose one server type.'|trans }}</small>
    {% else %}
      <input type="hidden" name="server_type" id="order_hetzner_server_type" value="{{ cfg.server_type|default('') }}">
      <div class="form-control" readonly>{{ cfg.server_type|default('') }}</div>
    {% endif %}
    <small class="form-hint" id="order_hetzner_type_hint"></small>
  </div>

  <div class="col-12">
    <label class="form-label">{{ 'Location'|trans }}</label>
    {% if cfg.allow_location_choice|default('0') in ['1', 1, true] %}
      <input type="hidden" id="order_hetzner_location" name="location" value="{{ cfg.location|default('') }}">
      <div id="order_hetzner_location_buttons" class="d-flex flex-wrap gap-2">
        <div class="small text-muted">{{ 'Loading locations...'|trans }}</div>
      </div>
      <small class="form-hint">{{ 'Inactive locations are not available for selected server type.'|trans }}</small>
      <small class="form-hint">{{ 'Required. Choose one location.'|trans }}</small>
    {% else %}
      <input type="hidden" name="location" id="order_hetzner_location" value="{{ cfg.location|default('') }}">
      <div class="form-control" readonly>{{ cfg.location|default('Any') }}</div>
    {% endif %}
  </div>

  <div class="col-12">
    <label class="form-label">{{ 'OS image'|trans }}</label>
    {% if cfg.allow_image_choice|default('0') in ['1', 1, true] %}
      <select class="form-select" id="order_hetzner_image" name="image" required>
        <option value="">{{ 'Loading...'|trans }}</option>
      </select>
    {% else %}
      <input type="hidden" name="image" id="order_hetzner_image" value="{{ cfg.image|default('ubuntu-24.04') }}">
      <div class="form-control" readonly>{{ cfg.image|default('ubuntu-24.04') }}</div>
    {% endif %}
  </div>

  <div class="col-12">
    <label class="form-label">{{ 'Networking'|trans }}</label>
    <div class="row g-3">
      {% set ipv4_mode = cfg.enable_ipv4_mode|default('force_on') %}
      <div class="col-md-6">
        <label class="form-label">{{ 'Public IPv4'|trans }}</label>
        {% if ipv4_mode == 'customer' %}
          <select class="form-select" name="enable_ipv4" id="order_hetzner_ipv4">
            <option value="1"{% if cfg.enable_ipv4_default|default('1') in ['1', 1, true] %} selected{% endif %}>{{ 'Enabled'|trans }}</option>
            <option value="0"{% if cfg.enable_ipv4_default|default('1') in ['0', 0, false] %} selected{% endif %}>{{ 'Disabled'|trans }}</option>
          </select>
        {% else %}
          <input type="hidden" name="enable_ipv4" id="order_hetzner_ipv4" value="{% if ipv4_mode == 'force_off' %}0{% else %}1{% endif %}">
          <div class="form-control" readonly>{% if ipv4_mode == 'force_off' %}{{ 'Disabled (forced)'|trans }}{% else %}{{ 'Enabled (forced)'|trans }}{% endif %}</div>
        {% endif %}
        <small class="form-hint" id="order_hetzner_ipv4_price_hint"></small>
      </div>

      {% set ipv6_mode = cfg.enable_ipv6_mode|default('force_on') %}
      <div class="col-md-6">
        <label class="form-label">{{ 'Public IPv6'|trans }}</label>
        {% if ipv6_mode == 'customer' %}
          <select class="form-select" name="enable_ipv6" id="order_hetzner_ipv6">
            <option value="1"{% if cfg.enable_ipv6_default|default('1') in ['1', 1, true] %} selected{% endif %}>{{ 'Enabled'|trans }}</option>
            <option value="0"{% if cfg.enable_ipv6_default|default('1') in ['0', 0, false] %} selected{% endif %}>{{ 'Disabled'|trans }}</option>
          </select>
        {% else %}
          <input type="hidden" name="enable_ipv6" id="order_hetzner_ipv6" value="{% if ipv6_mode == 'force_off' %}0{% else %}1{% endif %}">
          <div class="form-control" readonly>{% if ipv6_mode == 'force_off' %}{{ 'Disabled (forced)'|trans }}{% else %}{{ 'Enabled (forced)'|trans }}{% endif %}</div>
        {% endif %}
        <small class="form-hint" id="order_hetzner_ipv6_price_hint"></small>
      </div>
    </div>
  </div>

  {% set backups_mode = cfg.enable_backups_mode|default('force_off') %}
  <div class="col-12">
    <label class="form-label">{{ 'Daily Backups'|trans }}</label>
    {% if backups_mode == 'customer' %}
      <select class="form-select" name="enable_backups" id="order_hetzner_backups">
        <option value="1"{% if cfg.enable_backups_default|default('0') in ['1', 1, true] %} selected{% endif %}>{{ 'Enabled'|trans }}</option>
        <option value="0"{% if cfg.enable_backups_default|default('0') in ['0', 0, false] %} selected{% endif %}>{{ 'Disabled'|trans }}</option>
      </select>
    {% else %}
      <input type="hidden" name="enable_backups" id="order_hetzner_backups" value="{% if backups_mode == 'force_on' %}1{% else %}0{% endif %}">
      <div class="form-control" readonly>{% if backups_mode == 'force_on' %}{{ 'Enabled (forced)'|trans }}{% else %}{{ 'Disabled (forced)'|trans }}{% endif %}</div>
    {% endif %}
    <small class="form-hint" id="order_hetzner_backups_price_hint"></small>
  </div>

  {% set firewall_mode = cfg.firewall_mode|default('none') %}
  {% if firewall_mode in ['force', 'customer'] %}
    <div class="col-md-12">
      <label class="form-label">{{ 'Firewall IDs'|trans }}</label>
      {% if firewall_mode == 'customer' %}
        <select class="form-select" id="order_hetzner_firewall_ids" name="firewall_ids[]" multiple></select>
        <small class="form-hint">{{ 'Hold Ctrl/Cmd to select multiple firewalls.'|trans }}</small>
      {% else %}
        <input type="hidden" id="order_hetzner_firewall_ids_fixed" name="firewall_ids" value="{{ cfg.firewall_default_ids|default(cfg.firewall_ids|default('')) }}">
        <div class="form-control" readonly>{{ cfg.firewall_default_ids|default(cfg.firewall_ids|default('none')) }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% if product.pricing is defined %}
    <div class="col-12">
      <label class="form-label">{{ 'Billing'|trans }}</label>
      {% if billing_mode == 'prepaid_hours' %}
        {% set default_hours = cfg.prepaid_hours_default|default('24') %}
        {% set min_hours = cfg.prepaid_hours_min|default('1') %}
        {% set max_hours = cfg.prepaid_hours_max|default('8760') %}
        <div class="row g-2">
          <div class="col-md-4">
            <label class="form-label">{{ 'Prepaid hours'|trans }}</label>
            <input class="form-control" type="number" min="{{ min_hours }}" max="{{ max_hours }}" step="1" id="order_hetzner_prepaid_hours" name="prepaid_hours" value="{{ default_hours }}">
            <small class="form-hint">{{ 'Any partial usage is billed as a full hour. Use one-time product pricing where unit price equals one hour.'|trans }}</small>
          </div>
        </div>
        <input type="hidden" name="quantity" id="order_hetzner_quantity" value="{{ default_hours }}">
      {% else %}
        {% if product.pricing.type == 'recurrent' %}
          {% set periods = guest.system_periods %}
          <select class="form-select" name="period" id="order_hetzner_period" required>
            {% for code, prices in product.pricing.recurrent %}
              {% if prices.enabled %}
                <option value="{{ code }}" data-bb-price="{{ prices.price|money_convert }}">{{ prices.price|money_convert }}{% if prices.setup != '0.00' %} + {{ prices.setup|money_convert }} {{ 'setup'|trans }}{% endif %} ({{ periods[code] }})</option>
              {% endif %}
            {% endfor %}
          </select>
        {% elseif product.pricing.type == 'once' %}
          <div class="form-control" readonly>{{ (product.pricing.once.price + product.pricing.once.setup)|money_convert }}</div>
        {% else %}
          <div class="form-control" readonly>{{ 0|money_convert }}</div>
        {% endif %}
      {% endif %}
      {% if billing_mode == 'prepaid_hours' %}
        <small class="form-hint">{{ 'Prepaid estimate is calculated as hours × (server + IPv4 + IPv6 + backups) using Hetzner catalog rates and configured markup.'|trans }}</small>
      {% else %}
        <small class="form-hint">{{ 'Order totals are calculated from your FossBilling product and addon prices.'|trans }}</small>
      {% endif %}
    </div>

    <div class="col-12">
      <div class="mt-2">
        <div class="small text-muted" id="order_hetzner_billing_base_line"></div>
        <div class="small text-muted" id="order_hetzner_billing_addons_line"></div>
        <div class="small fw-semibold" id="order_hetzner_billing_total_line"></div>
        <div class="small text-muted" id="order_hetzner_billing_estimate_line"></div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .order-hetzner-server-type-group-title {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6c757d;
    margin-bottom: 0.45rem;
  }
  .order-hetzner-server-type-category-card {
    border: 1px solid #dee2e6;
    border-radius: 0.5rem;
    background: #fff;
    padding: 0.85rem;
    min-height: 100%;
  }
  .order-hetzner-server-type-category-card.is-selected {
    border-color: var(--bs-primary);
    box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.15);
  }
  .order-hetzner-server-type-category-card .badge {
    font-size: 0.68rem;
  }
  .order-hetzner-server-type-table-head,
  .order-hetzner-server-type-table-row {
    display: grid;
    grid-template-columns: 1.2fr 0.7fr 0.7fr 0.8fr 0.8fr 1fr 1fr;
    column-gap: 0.75rem;
    align-items: center;
  }
  .order-hetzner-server-type-table-head {
    border: 1px solid #dee2e6;
    border-bottom: 0;
    border-radius: 0.5rem 0.5rem 0 0;
    background: #f8f9fa;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6c757d;
    padding: 0.55rem 0.7rem;
  }
  .order-hetzner-server-type-table-row {
    width: 100%;
    text-align: left;
    border: 1px solid #dee2e6;
    border-top: 0;
    background: #fff;
    padding: 0.65rem 0.7rem;
  }
  .order-hetzner-server-type-table-row:last-child {
    border-radius: 0 0 0.5rem 0.5rem;
  }
  .order-hetzner-server-type-table-row.is-selected {
    border-left: 3px solid var(--bs-primary);
    background: rgba(13, 110, 253, 0.04);
  }
  .order-hetzner-server-type-table-row.is-inactive {
    opacity: 0.58;
    cursor: not-allowed;
  }
  .order-hetzner-server-type-table-row .col-name {
    font-weight: 600;
  }
  .order-hetzner-server-type-table-row .col-price {
    white-space: nowrap;
  }
  @media (max-width: 991.98px) {
    .order-hetzner-server-type-table-head {
      display: none;
    }
    .order-hetzner-server-type-table-row {
      grid-template-columns: 1fr;
      row-gap: 0.35rem;
      border-top: 1px solid #dee2e6;
      margin-top: 0.5rem;
      border-radius: 0.5rem;
    }
    .order-hetzner-server-type-table-row .col-meta::before,
    .order-hetzner-server-type-table-row .col-price::before {
      display: inline-block;
      min-width: 4.2rem;
      font-size: 0.72rem;
      color: #6c757d;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      margin-right: 0.4rem;
    }
    .order-hetzner-server-type-table-row .col-cores::before { content: "vCPU"; }
    .order-hetzner-server-type-table-row .col-memory::before { content: "RAM"; }
    .order-hetzner-server-type-table-row .col-disk::before { content: "SSD"; }
    .order-hetzner-server-type-table-row .col-traffic::before { content: "Traffic"; }
    .order-hetzner-server-type-table-row .col-hourly::before { content: "Price/h"; }
    .order-hetzner-server-type-table-row .col-monthly::before { content: "Price/mo"; }
  }
</style>

<script>
(function() {
  const cfg = {
    allowServerTypeChoice: {{ (cfg.allow_server_type_choice|default('0') in ['1', 1, true]) ? 'true' : 'false' }},
    allowLocationChoice: {{ (cfg.allow_location_choice|default('0') in ['1', 1, true]) ? 'true' : 'false' }},
    allowImageChoice: {{ (cfg.allow_image_choice|default('0') in ['1', 1, true]) ? 'true' : 'false' }},
    projectRef: {{ (cfg.project_ref|default(''))|json_encode|raw }},
    serverType: {{ (cfg.server_type|default(''))|json_encode|raw }},
    location: {{ (cfg.location|default(''))|json_encode|raw }},
    image: {{ (cfg.image|default('ubuntu-24.04'))|json_encode|raw }},
    firewallMode: {{ (cfg.firewall_mode|default('none'))|json_encode|raw }},
    firewallIds: {{ (cfg.firewall_ids|default(''))|json_encode|raw }},
    firewallDefaultIds: {{ (cfg.firewall_default_ids|default(''))|json_encode|raw }},
    billingMode: {{ (cfg.billing_mode|default('standard'))|json_encode|raw }},
    prepaidHoursDefault: Number({{ (cfg.prepaid_hours_default|default('24'))|json_encode|raw }}) || 24,
    prepaidHoursMin: Number({{ (cfg.prepaid_hours_min|default('1'))|json_encode|raw }}) || 1,
    prepaidHoursMax: Number({{ (cfg.prepaid_hours_max|default('8760'))|json_encode|raw }}) || 8760,
    topupHoursMin: Number({{ (cfg.topup_hours_min|default('1'))|json_encode|raw }}) || 1,
    topupHoursMax: Number({{ (cfg.topup_hours_max|default('8760'))|json_encode|raw }}) || 8760,
    hourlyRateOverride: Number({{ (cfg.hourly_rate|default('0'))|json_encode|raw }}) || 0,
    autoSuspendOnExhaustion: {{ (cfg.auto_suspend_on_exhaustion|default('1') in ['1', 1, true]) ? 'true' : 'false' }},
    autoPoweronOnTopup: {{ (cfg.auto_poweron_on_topup|default('1') in ['1', 1, true]) ? 'true' : 'false' }},
    addonIpv4Id: Number({{ (cfg.addon_id_ipv4|default('0'))|json_encode|raw }}) || 0,
    addonBackupsId: Number({{ (cfg.addon_id_backups|default('0'))|json_encode|raw }}) || 0,
    addonIpv6Id: Number({{ (cfg.addon_id_ipv6|default('0'))|json_encode|raw }}) || 0,
    addonFirewallId: Number({{ (cfg.addon_id_firewall|default('0'))|json_encode|raw }}) || 0,
    priceMarkupPercent: Number({{ (cfg.price_markup_percent|default('0'))|json_encode|raw }}) || 0
  };

  const billing = {
    product: {
      type: {{ (product.pricing.type|default('free'))|json_encode|raw }},
      once: {
        price: Number({{ (product.pricing.once.price|default('0'))|json_encode|raw }}) || 0,
        setup: Number({{ (product.pricing.once.setup|default('0'))|json_encode|raw }}) || 0,
        priceLabel: {{ (product.pricing.once.price|default('0')|money_convert)|json_encode|raw }},
        setupLabel: {{ (product.pricing.once.setup|default('0')|money_convert)|json_encode|raw }}
      },
      recurrent: {
{% for code, prices in product.pricing.recurrent|default({}) %}
        {{ (code ~ '')|json_encode|raw }}: {
          price: Number({{ (prices.price|default('0'))|json_encode|raw }}) || 0,
          setup: Number({{ (prices.setup|default('0'))|json_encode|raw }}) || 0,
          priceLabel: {{ (prices.price|default('0')|money_convert)|json_encode|raw }},
          setupLabel: {{ (prices.setup|default('0')|money_convert)|json_encode|raw }}
        },
{% endfor %}
      }
    },
    addons: {
{% for addon in product.addons|default([]) %}
      {{ (addon.id ~ '')|json_encode|raw }}: {
        id: Number({{ (addon.id ~ '')|json_encode|raw }}) || 0,
        title: {{ (addon.title|default('Addon'))|json_encode|raw }},
        type: {{ (addon.pricing.type|default('free'))|json_encode|raw }},
        once: {
          price: Number({{ (addon.pricing.once.price|default('0'))|json_encode|raw }}) || 0,
          setup: Number({{ (addon.pricing.once.setup|default('0'))|json_encode|raw }}) || 0,
          priceLabel: {{ (addon.pricing.once.price|default('0')|money_convert)|json_encode|raw }},
          setupLabel: {{ (addon.pricing.once.setup|default('0')|money_convert)|json_encode|raw }}
        },
        recurrent: {
{% for code, prices in addon.pricing.recurrent|default({}) %}
          {{ (code ~ '')|json_encode|raw }}: {
            price: Number({{ (prices.price|default('0'))|json_encode|raw }}) || 0,
            setup: Number({{ (prices.setup|default('0'))|json_encode|raw }}) || 0,
            priceLabel: {{ (prices.price|default('0')|money_convert)|json_encode|raw }},
            setupLabel: {{ (prices.setup|default('0')|money_convert)|json_encode|raw }}
          },
{% endfor %}
        }
      },
{% endfor %}
    }
  };

  let catalog = { server_types: [], locations: [], images: [], firewalls: [], option_pricing: {} };
  let billingCurrencyCode = '';
  let selectedServerCategory = 'cost_optimized';
  let selectedCategoryArchitecture = {};

  function esc(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatPrice(v, currency) {
    if (v === null || v === undefined || v === '') {
      return '-';
    }
    const n = Number(v);
    if (Number.isNaN(n)) {
      return esc(v);
    }
    const marked = n * (1 + (cfg.priceMarkupPercent / 100));
    return marked.toFixed(5) + ' ' + esc(currency || 'EUR');
  }

  function formatIncludedTraffic(value) {
    const bytes = Number(value);
    if (Number.isNaN(bytes) || bytes <= 0) {
      return '-';
    }
    const tebibytes = bytes / (1024 * 1024 * 1024 * 1024);
    if (tebibytes >= 1) {
      return (tebibytes >= 10 ? tebibytes.toFixed(0) : tebibytes.toFixed(1)) + ' TB';
    }
    const gibibytes = bytes / (1024 * 1024 * 1024);
    return gibibytes.toFixed(0) + ' GB';
  }

  function toNumberOrNull(value) {
    if (value === null || value === undefined || value === '') {
      return null;
    }
    const parsed = Number(value);
    return Number.isNaN(parsed) ? null : parsed;
  }

  function normalizeRatePair(hourlyValue, monthlyValue) {
    let hourly = toNumberOrNull(hourlyValue);
    let monthly = toNumberOrNull(monthlyValue);

    if ((hourly === null || hourly <= 0) && monthly !== null && monthly > 0) {
      hourly = monthly / 730;
    }
    if ((monthly === null || monthly <= 0) && hourly !== null && hourly > 0) {
      monthly = hourly * 730;
    }

    return { hourly: hourly, monthly: monthly };
  }

  const FLAG_SVGS = {
    DE: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect width="24" height="16" fill="#FFCE00"/><rect width="24" height="10.67" fill="#DD0000"/><rect width="24" height="5.33" fill="#000000"/></svg>',
    US: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect width="24" height="16" fill="#B22234"/><rect y="2" width="24" height="2" fill="#FFFFFF"/><rect y="6" width="24" height="2" fill="#FFFFFF"/><rect y="10" width="24" height="2" fill="#FFFFFF"/><rect y="14" width="24" height="2" fill="#FFFFFF"/><rect width="10" height="7" fill="#3C3B6E"/><circle cx="2" cy="2" r="0.6" fill="#FFFFFF"/><circle cx="4" cy="3.5" r="0.6" fill="#FFFFFF"/><circle cx="6" cy="2" r="0.6" fill="#FFFFFF"/><circle cx="8" cy="3.5" r="0.6" fill="#FFFFFF"/></svg>',
    FI: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect width="24" height="16" fill="#FFFFFF"/><rect x="7" width="4" height="16" fill="#003580"/><rect y="6" width="24" height="4" fill="#003580"/></svg>',
    SG: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect width="24" height="8" fill="#EF3340"/><rect y="8" width="24" height="8" fill="#FFFFFF"/><circle cx="6.5" cy="4" r="2.2" fill="#FFFFFF"/><circle cx="7.3" cy="4" r="1.8" fill="#EF3340"/><circle cx="10.3" cy="2.6" r="0.35" fill="#FFFFFF"/><circle cx="11.2" cy="3.5" r="0.35" fill="#FFFFFF"/><circle cx="11.2" cy="4.7" r="0.35" fill="#FFFFFF"/><circle cx="10.3" cy="5.6" r="0.35" fill="#FFFFFF"/><circle cx="9.1" cy="4.1" r="0.35" fill="#FFFFFF"/></svg>'
  };

  const DEFAULT_FLAG_SVG = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 16" width="24" height="16" aria-hidden="true"><rect width="24" height="16" rx="2" ry="2" fill="#E5E7EB"/><circle cx="12" cy="8" r="4.2" fill="#9CA3AF"/><path d="M7.8 8h8.4M12 3.8v8.4" stroke="#E5E7EB" stroke-width="1"/></svg>';

  function normalizeCountryCode(value) {
    const raw = String(value || '').trim().toUpperCase();
    if (/^[A-Z]{2}$/.test(raw)) return raw;

    const byName = {
      GERMANY: 'DE',
      UNITED_STATES: 'US',
      USA: 'US',
      FINLAND: 'FI',
      SINGAPORE: 'SG'
    };
    const key = raw.replace(/\s+/g, '_');
    return byName[key] || '';
  }

  function getFlagSvg(countryCode) {
    const code = normalizeCountryCode(countryCode);
    return FLAG_SVGS[code] || DEFAULT_FLAG_SVG;
  }

  function getServerTypeFamily(name) {
    const value = String(name || '').trim().toLowerCase();
    const match = value.match(/^([a-z]+)\d*$/);
    return match ? match[1] : value;
  }

  function getServerTypeSize(name) {
    const value = String(name || '').trim().toLowerCase();
    const match = value.match(/[a-z]+(\d+)$/);
    return match ? parseInt(match[1], 10) : 0;
  }

  function getServerTypeCategory(name, cpuType, apiCategory) {
    const category = String(apiCategory || '').trim().toLowerCase();
    if (category === 'cost_optimized') return 'cost_optimized';
    if (category === 'regular_purpose') return 'balanced';
    if (category === 'general_purpose') return 'dedicated_cpu';

    const family = getServerTypeFamily(name);
    const cpu = String(cpuType || '').toLowerCase();
    if (cpu === 'dedicated' || family === 'ccx') return 'dedicated_cpu';
    if (family === 'cpx') return 'balanced';
    if (family === 'cx' || family === 'cax') return 'cost_optimized';
    return 'other';
  }

  function getServerTypeCategoryMeta(key) {
    const map = {
      cost_optimized: {
        title: 'Cost-Optimized',
        group: 'shared_resources',
        groupTitle: 'Shared Resources',
        order: 10,
        description: 'Cost-efficient shared vCPU plans for variable workloads.',
        badges: ['Cost effective', 'Low CPU usage']
      },
      balanced: {
        title: 'Regular Performance',
        group: 'shared_resources',
        groupTitle: 'Shared Resources',
        order: 20,
        description: 'Shared vCPU plans with stronger baseline performance.',
        badges: ['Best price/performance', 'Low to medium CPU usage']
      },
      dedicated_cpu: {
        title: 'General Purpose',
        group: 'dedicated_resources',
        groupTitle: 'Dedicated Resources',
        order: 30,
        description: 'Dedicated vCPU plans for consistent production workloads.',
        badges: ['Predictable performance', 'Sustained CPU usage']
      },
      other: {
        title: 'Other',
        group: 'other',
        groupTitle: 'Other',
        order: 99,
        description: 'Additional server families',
        badges: []
      }
    };
    return map[key] || map.other;
  }

  function getArchitectureLabel(arch) {
    const normalized = normalizeArchitectureValue(arch);
    if (normalized === 'x86_64') return 'x86 (Intel/AMD)';
    if (normalized === 'arm64') return 'Arm64 (Ampere)';
    return normalized || 'Mixed';
  }

  function sortArchitectures(values) {
    const order = { x86_64: 10, arm64: 20 };
    return values.slice().sort(function(a, b) {
      const ra = a in order ? order[a] : 999;
      const rb = b in order ? order[b] : 999;
      if (ra !== rb) return ra - rb;
      return String(a).localeCompare(String(b));
    });
  }

  function collectCategoryArchitectures(types) {
    const set = {};
    (types || []).forEach(function(type) {
      const arch = normalizeArchitectureValue((type || {}).architecture || (type || {}).architecture_raw || '');
      if (arch) set[arch] = true;
    });
    return sortArchitectures(Object.keys(set));
  }

  function sortServerTypes(a, b) {
    const catA = getServerTypeCategoryMeta(getServerTypeCategory(a.name, a.cpu_type || a.cpuType || '', a.category || ''));
    const catB = getServerTypeCategoryMeta(getServerTypeCategory(b.name, b.cpu_type || b.cpuType || '', b.category || ''));
    if (catA.order !== catB.order) return catA.order - catB.order;

    const familyOrder = { cx: 10, cax: 20, cpx: 30, ccx: 40 };
    const famA = getServerTypeFamily(a.name);
    const famB = getServerTypeFamily(b.name);
    const famRankA = famA in familyOrder ? familyOrder[famA] : 999;
    const famRankB = famB in familyOrder ? familyOrder[famB] : 999;
    if (famRankA !== famRankB) return famRankA - famRankB;

    const sizeA = getServerTypeSize(a.name);
    const sizeB = getServerTypeSize(b.name);
    if (sizeA !== sizeB) return sizeA - sizeB;

    return String(a.name || '').localeCompare(String(b.name || ''));
  }

  function normalizeArchitectureValue(value) {
    const raw = String(value || '').trim().toLowerCase();
    if (!raw) return '';
    const compact = raw.replace(/[-_\s]/g, '');
    if (compact.indexOf('arm') !== -1 || compact.indexOf('aarch64') !== -1) return 'arm64';
    if (compact.indexOf('x86') !== -1 || compact.indexOf('amd64') !== -1 || compact.indexOf('intel64') !== -1) return 'x86_64';
    return raw;
  }

  function parseIdList(value) {
    if (!value) return [];
    return String(value).split(',').map(function(v) { return parseInt(v.trim(), 10); }).filter(function(v) { return Number.isInteger(v) && v > 0; });
  }

  function parseBooleanValue(value, defaultValue) {
    if (value === null || value === undefined || value === '') {
      return !!defaultValue;
    }
    return ['1', 'true', 'yes', 'on'].indexOf(String(value).toLowerCase()) !== -1;
  }

  function getSelectedLocationName() {
    const el = document.getElementById('order_hetzner_location');
    if (el) {
      const raw = String(el.value || '').trim();
      if (raw !== '') return raw;
    }
    const fixed = String(cfg.location || '').trim();
    return fixed;
  }

  function findLocationPrice(locationPrices, locationName) {
    if (!Array.isArray(locationPrices) || !locationPrices.length) return null;

    let fallback = null;
    locationPrices.forEach(function(row) {
      if (!row || typeof row !== 'object') return;

      const monthly = Number(row.monthly_gross);
      const hourly = Number(row.hourly_gross);
      const normalized = {
        monthly_gross: Number.isNaN(monthly) ? null : monthly,
        hourly_gross: Number.isNaN(hourly) ? null : hourly,
        included_traffic: row.included_traffic !== null && row.included_traffic !== undefined && row.included_traffic !== '' && !Number.isNaN(Number(row.included_traffic))
          ? Number(row.included_traffic)
          : null,
        currency: String(row.currency || '')
      };

      if (!fallback) {
        fallback = normalized;
      }
      if (locationName && String(row.location || '') === locationName) {
        fallback = normalized;
      }
    });

    return fallback;
  }

  function findExactLocationPrice(locationPrices, locationName) {
    if (!Array.isArray(locationPrices) || !locationPrices.length) return null;
    if (!locationName) return null;

    let exact = null;
    locationPrices.forEach(function(row) {
      if (!row || typeof row !== 'object') return;
      if (String(row.location || '') !== String(locationName)) return;

      const monthly = Number(row.monthly_gross);
      const hourly = Number(row.hourly_gross);
      exact = {
        monthly_gross: Number.isNaN(monthly) ? null : monthly,
        hourly_gross: Number.isNaN(hourly) ? null : hourly,
        included_traffic: row.included_traffic !== null && row.included_traffic !== undefined && row.included_traffic !== '' && !Number.isNaN(Number(row.included_traffic))
          ? Number(row.included_traffic)
          : null,
        currency: String(row.currency || '')
      };
    });

    return exact;
  }

  function resolveOptionPrice(optionData, locationName, fallbackCurrency) {
    const row = findLocationPrice((optionData || {}).location_prices, locationName);
    if (row && (row.hourly_gross !== null || row.monthly_gross !== null)) {
      const pair = normalizeRatePair(row.hourly_gross, row.monthly_gross);
      if (pair.hourly !== null || pair.monthly !== null) {
        return {
          hourly_gross: pair.hourly,
          monthly_gross: pair.monthly,
          currency: String(row.currency || (optionData || {}).currency || fallbackCurrency || '')
        };
      }
    }

    const pair = normalizeRatePair((optionData || {}).from_hourly_gross, (optionData || {}).from_monthly_gross);
    if (pair.hourly === null && pair.monthly === null) {
      return null;
    }

    return {
      hourly_gross: pair.hourly,
      monthly_gross: pair.monthly,
      currency: String((optionData || {}).currency || fallbackCurrency || '')
    };
  }

  function formatEstimatePair(hourly, monthly, currency) {
    return formatPrice(hourly, currency) + ' hourly / ' + formatPrice(monthly, currency) + ' monthly';
  }

  function setHintText(id, text) {
    const el = document.getElementById(id);
    if (el) el.textContent = text || '';
  }

  function formatCurrencyAmount(amount) {
    const value = Number(amount);
    if (Number.isNaN(value)) {
      return '0.00';
    }
    if (billingCurrencyCode) {
      try {
        return new Intl.NumberFormat(undefined, { style: 'currency', currency: billingCurrencyCode }).format(value);
      } catch (e) {
        // Ignore invalid currency and fall through to fixed precision formatting.
      }
    }
    return value.toFixed(2);
  }

  function getSelectedPeriodCode() {
    const el = document.getElementById('order_hetzner_period');
    return el ? String(el.value || '') : '';
  }

  function getFirstKey(obj) {
    if (!obj || typeof obj !== 'object') return '';
    const keys = Object.keys(obj);
    return keys.length ? keys[0] : '';
  }

  function getChargeForProductPeriod(periodCode) {
    const type = String((billing.product || {}).type || 'free');
    if (type === 'once') {
      return billing.product.once || { price: 0, setup: 0, priceLabel: '0', setupLabel: '0' };
    }
    if (type !== 'recurrent') {
      return { price: 0, setup: 0, priceLabel: '0', setupLabel: '0' };
    }

    const recurrent = (billing.product || {}).recurrent || {};
    const code = periodCode || getFirstKey(recurrent);
    return recurrent[code] || { price: 0, setup: 0, priceLabel: '0', setupLabel: '0' };
  }

  function getAddonConfig(addonId) {
    const key = String(addonId || '');
    return (billing.addons || {})[key] || null;
  }

  function isAddonSelected(addonId) {
    const id = Number(addonId || 0);
    if (!id) return false;
    const checked = document.querySelector('input[name="addons[' + id + '][selected]"]:checked');
    if (!checked) return false;
    return String(checked.value || '0') === '1';
  }

  function getAddonCharge(addonId, productPeriod) {
    const addon = getAddonConfig(addonId);
    if (!addon) return { title: '', price: 0, setup: 0, priceLabel: '0', setupLabel: '0', period: '' };

    const type = String(addon.type || 'free');
    if (type === 'once') {
      return Object.assign({ title: addon.title || 'Addon', period: '' }, addon.once || {});
    }
    if (type !== 'recurrent') {
      return { title: addon.title || 'Addon', price: 0, setup: 0, priceLabel: '0', setupLabel: '0', period: '' };
    }

    const periodSelect = document.querySelector('select[name="addons[' + Number(addonId) + '][period]"]');
    const chosen = String((periodSelect && periodSelect.value) ? periodSelect.value : (productPeriod || ''));
    const recurrent = addon.recurrent || {};
    const charge = recurrent[chosen] || recurrent[getFirstKey(recurrent)] || { price: 0, setup: 0, priceLabel: '0', setupLabel: '0' };
    return Object.assign({ title: addon.title || 'Addon', period: chosen }, charge);
  }

  function formatChargeInline(charge) {
    const priceLabel = String(charge.priceLabel || '');
    const setupLabel = String(charge.setupLabel || '');
    const setupRaw = Number(charge.setup || 0);
    if (setupLabel && !Number.isNaN(setupRaw) && Math.abs(setupRaw) > 0.0000001) {
      return priceLabel + ' + ' + setupLabel + ' setup';
    }
    return priceLabel || formatCurrencyAmount(Number(charge.price || 0));
  }

  function parseBooleanInput(id, fallbackValue) {
    const el = document.getElementById(id);
    const val = el ? el.value : '';
    return parseBooleanValue(val, fallbackValue);
  }

  function normalizeHoursInput(value) {
    const parsed = parseInt(String(value || ''), 10);
    const minHours = Math.max(1, parseInt(String(cfg.prepaidHoursMin || 1), 10) || 1);
    const maxHours = Math.max(minHours, parseInt(String(cfg.prepaidHoursMax || 8760), 10) || 8760);
    if (!Number.isInteger(parsed) || parsed < minHours) {
      return minHours;
    }
    if (parsed > maxHours) {
      return maxHours;
    }
    return parsed;
  }

  function getSelectedPrepaidHours() {
    const input = document.getElementById('order_hetzner_prepaid_hours');
    if (!input) {
      return normalizeHoursInput(cfg.prepaidHoursDefault || 24);
    }
    return normalizeHoursInput(input.value);
  }

  function syncPrepaidHoursQuantity() {
    if (String(cfg.billingMode || 'standard') !== 'prepaid_hours') {
      return;
    }
    const hours = getSelectedPrepaidHours();
    const input = document.getElementById('order_hetzner_prepaid_hours');
    if (input) {
      input.value = String(hours);
    }
    const qty = document.getElementById('order_hetzner_quantity');
    if (qty) {
      qty.value = String(hours);
    }
  }

  function getFirewallSelectionCount() {
    if (cfg.firewallMode === 'customer') {
      const el = document.getElementById('order_hetzner_firewall_ids');
      if (!el) return 0;
      return Array.prototype.slice.call(el.options || []).filter(function(op) { return !!op.selected; }).length;
    }

    const fixed = document.getElementById('order_hetzner_firewall_ids_fixed');
    const fixedList = fixed ? parseIdList(fixed.value) : parseIdList(cfg.firewallDefaultIds || cfg.firewallIds || '');
    return fixedList.length;
  }

  function setAddonSelected(addonId, enabled) {
    const id = Number(addonId || 0);
    if (!id || id < 1) return;

    const add = document.getElementById('addon_' + id);
    const decline = document.getElementById('addon_' + id + '_decline');
    if (!add || !decline) return;

    add.checked = !!enabled;
    decline.checked = !enabled;
  }

  function syncMappedAddons() {
    const ipv4Enabled = parseBooleanValue((document.getElementById('order_hetzner_ipv4') || {}).value, true);
    const ipv6Enabled = parseBooleanValue((document.getElementById('order_hetzner_ipv6') || {}).value, true);
    const backupsEnabled = parseBooleanValue((document.getElementById('order_hetzner_backups') || {}).value, false);
    const firewallEnabled = getFirewallSelectionCount() > 0;

    setAddonSelected(cfg.addonIpv4Id, ipv4Enabled);
    setAddonSelected(cfg.addonIpv6Id, ipv6Enabled);
    setAddonSelected(cfg.addonBackupsId, backupsEnabled);
    setAddonSelected(cfg.addonFirewallId, firewallEnabled);
    updateBillingSummary();
  }

  function getSelectedType() {
    const el = document.getElementById('order_hetzner_server_type');
    const selected = el ? String(el.value || '') : String(cfg.serverType || '');
    return (catalog.server_types || []).find(function(type) {
      return String(type.name || '') === selected;
    }) || null;
  }

  function isServerAvailableInLocation(type, locationName) {
    if (type && Boolean(type.deprecated)) {
      return false;
    }
    const allowed = type && Array.isArray(type.available_locations)
      ? type.available_locations.map(function(v) { return String(v); })
      : [];
    if (!locationName || !String(locationName).trim()) return true;
    if (!allowed.length) return true;
    return allowed.indexOf(String(locationName)) !== -1;
  }

  function renderTypeHint() {
    const hint = document.getElementById('order_hetzner_type_hint');
    const type = getSelectedType();
    if (!hint || !type) {
      if (hint) hint.textContent = '';
      return;
    }

    const location = getSelectedLocationName();
    const row = findExactLocationPrice(((type.pricing || {}).location_prices || []), location) || findLocationPrice(((type.pricing || {}).location_prices || []), location);
    if (row && (row.hourly_gross !== null || row.monthly_gross !== null)) {
      const pair = normalizeRatePair(row.hourly_gross, row.monthly_gross);
      if (pair.hourly !== null || pair.monthly !== null) {
        hint.textContent = 'Estimated selected-location price: ' + formatPrice(pair.hourly, row.currency || type.price_currency) + ' hourly / ' + formatPrice(pair.monthly, row.currency || type.price_currency) + ' monthly';
        return;
      }
    }

    const fromPair = normalizeRatePair(type.price_hourly_from, type.price_monthly_from);
    hint.textContent = 'Estimated from-price: ' + formatPrice(fromPair.hourly, type.price_currency) + ' hourly / ' + formatPrice(fromPair.monthly, type.price_currency) + ' monthly';
  }

  function renderOptionPricingHints() {
    const type = getSelectedType();
    const location = getSelectedLocationName();
    const optionPricing = (catalog && catalog.option_pricing) ? catalog.option_pricing : {};
    const currency = String(optionPricing.currency || (type ? (type.price_currency || 'EUR') : 'EUR'));

    let ipv4Text = '';
    const ipv4Pricing = optionPricing.ipv4 || {};
    const ipv4Row = resolveOptionPrice(ipv4Pricing, location, currency);
    if (ipv4Row && (ipv4Row.hourly_gross !== null || ipv4Row.monthly_gross !== null)) {
      ipv4Text = 'Hetzner estimate: ' + formatEstimatePair(ipv4Row.hourly_gross, ipv4Row.monthly_gross, ipv4Row.currency || currency);
    }

    let ipv6Text = '';
    const ipv6Pricing = optionPricing.ipv6 || {};
    const ipv6Row = resolveOptionPrice(ipv6Pricing, location, currency);
    if (ipv6Row && (ipv6Row.hourly_gross !== null || ipv6Row.monthly_gross !== null)) {
      ipv6Text = 'Hetzner estimate: ' + formatEstimatePair(ipv6Row.hourly_gross, ipv6Row.monthly_gross, ipv6Row.currency || currency);
    }

    let backupsText = '';
    const backupPctRaw = Number(optionPricing.backup_percentage);
    const backupPct = Number.isNaN(backupPctRaw) ? null : backupPctRaw;
    if (type && backupPct !== null) {
      const typeRow = findLocationPrice(((type.pricing || {}).location_prices || []), location);
      if (typeRow && (typeRow.hourly_gross !== null || typeRow.monthly_gross !== null)) {
        const backupHourly = typeRow.hourly_gross === null ? null : (typeRow.hourly_gross * (backupPct / 100));
        const backupMonthly = typeRow.monthly_gross === null ? null : (typeRow.monthly_gross * (backupPct / 100));
        backupsText = 'Hetzner estimate: +' + formatEstimatePair(backupHourly, backupMonthly, typeRow.currency || currency) + ' (' + backupPct + '% of server price)';
      }
    }

    setHintText('order_hetzner_ipv4_price_hint', ipv4Text);
    setHintText('order_hetzner_ipv6_price_hint', ipv6Text);
    setHintText('order_hetzner_backups_price_hint', backupsText);
  }

  function computeInfraEstimate() {
    const type = getSelectedType();
    if (!type) return null;

    const location = getSelectedLocationName();
    const typeRow = findLocationPrice(((type.pricing || {}).location_prices || []), location) || {};
    const serverPair = normalizeRatePair(typeRow.hourly_gross, typeRow.monthly_gross);
    let serverHourly = serverPair.hourly;
    let serverMonthly = serverPair.monthly;
    const currency = String(typeRow.currency || type.price_currency || ((catalog.option_pricing || {}).currency || 'EUR'));
    if (serverHourly === null || serverMonthly === null) {
      const fallbackPair = normalizeRatePair(type.price_hourly_from, type.price_monthly_from);
      if (serverHourly === null) serverHourly = fallbackPair.hourly;
      if (serverMonthly === null) serverMonthly = fallbackPair.monthly;
    }
    if (serverHourly === null) serverHourly = 0;
    if (serverMonthly === null) serverMonthly = 0;

    const options = (catalog.option_pricing || {});
    let ipv4Hourly = 0;
    let ipv4Monthly = 0;
    if (parseBooleanInput('order_hetzner_ipv4', true)) {
      const ipv4Row = resolveOptionPrice(options.ipv4 || {}, location, currency);
      if (ipv4Row) {
        const pair = normalizeRatePair(ipv4Row.hourly_gross, ipv4Row.monthly_gross);
        if (pair.hourly !== null) ipv4Hourly = pair.hourly;
        if (pair.monthly !== null) ipv4Monthly = pair.monthly;
      }
    }

    let ipv6Hourly = 0;
    let ipv6Monthly = 0;
    if (parseBooleanInput('order_hetzner_ipv6', true)) {
      const ipv6Row = resolveOptionPrice(options.ipv6 || {}, location, currency);
      if (ipv6Row) {
        const pair = normalizeRatePair(ipv6Row.hourly_gross, ipv6Row.monthly_gross);
        if (pair.hourly !== null) ipv6Hourly = pair.hourly;
        if (pair.monthly !== null) ipv6Monthly = pair.monthly;
      }
    }

    let backupsHourly = 0;
    let backupsMonthly = 0;
    if (parseBooleanInput('order_hetzner_backups', false)) {
      const pctRaw = Number(options.backup_percentage);
      if (!Number.isNaN(pctRaw)) {
        backupsHourly = serverHourly * (pctRaw / 100);
        backupsMonthly = serverMonthly * (pctRaw / 100);
      }
    }

    const hourly = serverHourly + ipv4Hourly + ipv6Hourly + backupsHourly;
    const monthly = serverMonthly + ipv4Monthly + ipv6Monthly + backupsMonthly;

    return {
      hourly: hourly,
      monthly: monthly,
      currency: currency,
      breakdown: {
        serverHourly: serverHourly,
        serverMonthly: serverMonthly,
        ipv4Hourly: ipv4Hourly,
        ipv4Monthly: ipv4Monthly,
        ipv6Hourly: ipv6Hourly,
        ipv6Monthly: ipv6Monthly,
        backupsHourly: backupsHourly,
        backupsMonthly: backupsMonthly
      }
    };
  }

  function updateBillingSummary() {
    const baseLine = document.getElementById('order_hetzner_billing_base_line');
    const addonsLine = document.getElementById('order_hetzner_billing_addons_line');
    const totalLine = document.getElementById('order_hetzner_billing_total_line');
    const estimateLine = document.getElementById('order_hetzner_billing_estimate_line');
    if (!baseLine || !addonsLine || !totalLine || !estimateLine) {
      return;
    }

    const isPrepaidMode = String(cfg.billingMode || 'standard') === 'prepaid_hours';
    const infra = computeInfraEstimate();

    if (isPrepaidMode) {
      syncPrepaidHoursQuantity();
      const hours = getSelectedPrepaidHours();
      if (!infra) {
        baseLine.textContent = 'Base product: select a server type to calculate hourly pricing.';
        addonsLine.textContent = 'Selected addons: none';
        totalLine.textContent = 'Estimated invoice now: -';
        estimateLine.textContent = '';
        return;
      }

      const breakdown = infra.breakdown || {};
      const serverTotal = (Number(breakdown.serverHourly) || 0) * hours;
      const ipv4Total = (Number(breakdown.ipv4Hourly) || 0) * hours;
      const ipv6Total = (Number(breakdown.ipv6Hourly) || 0) * hours;
      const backupsTotal = (Number(breakdown.backupsHourly) || 0) * hours;
      const invoiceHoursTotal = (Number(infra.hourly) || 0) * hours;

      baseLine.textContent = 'Base server (' + hours + 'h): ' + formatPrice(serverTotal, infra.currency);

      const addonParts = [];
      if ((Number(breakdown.ipv4Hourly) || 0) > 0) {
        addonParts.push('IPv4 (' + hours + 'h): ' + formatPrice(ipv4Total, infra.currency));
      }
      if ((Number(breakdown.ipv6Hourly) || 0) > 0) {
        addonParts.push('IPv6 (' + hours + 'h): ' + formatPrice(ipv6Total, infra.currency));
      }
      if ((Number(breakdown.backupsHourly) || 0) > 0) {
        addonParts.push('Backups (' + hours + 'h): ' + formatPrice(backupsTotal, infra.currency));
      }
      addonsLine.textContent = addonParts.length ? ('Selected addons: ' + addonParts.join(' | ')) : 'Selected addons: none';

      totalLine.textContent = 'Estimated invoice now: ' + formatPrice(invoiceHoursTotal, infra.currency);
      estimateLine.textContent = 'Hetzner infra estimate: ' + formatPrice(infra.hourly, infra.currency) + ' hourly / ' + formatPrice(infra.monthly, infra.currency) + ' monthly';
      return;
    }

    const period = getSelectedPeriodCode();
    const baseCharge = getChargeForProductPeriod(period);
    let baseTotal = 0;
    if (!isPrepaidMode) {
      baseTotal = (Number(baseCharge.price) || 0) + (Number(baseCharge.setup) || 0);
    }

    const periodLabel = period ? (' (' + period + ')') : '';
    if (!isPrepaidMode) {
      baseLine.textContent = 'Base product' + periodLabel + ': ' + formatChargeInline(baseCharge);
    }

    const mappedAddonIds = Array.from(new Set([
      Number(cfg.addonIpv4Id || 0),
      Number(cfg.addonIpv6Id || 0),
      Number(cfg.addonBackupsId || 0),
      Number(cfg.addonFirewallId || 0)
    ].filter(function(id) { return id > 0; })));

    const addonParts = [];
    let addonsTotal = 0;
    mappedAddonIds.forEach(function(id) {
      if (!isAddonSelected(id)) return;
      const charge = getAddonCharge(id, period);
      addonsTotal += (Number(charge.price) || 0) + (Number(charge.setup) || 0);
      addonParts.push((charge.title || ('Addon #' + id)) + ': ' + formatChargeInline(charge));
    });
    addonsLine.textContent = addonParts.length ? ('Selected addons: ' + addonParts.join(' | ')) : 'Selected addons: none';

    const invoiceNow = baseTotal + addonsTotal;
    totalLine.textContent = 'Estimated invoice now: ' + formatCurrencyAmount(invoiceNow);

    if (infra) {
      estimateLine.textContent = 'Hetzner infra estimate: ' + formatPrice(infra.hourly, infra.currency) + ' hourly / ' + formatPrice(infra.monthly, infra.currency) + ' monthly';
    } else {
      estimateLine.textContent = '';
    }
  }

  function populateServerTypes() {
    if (!cfg.allowServerTypeChoice) {
      renderTypeHint();
      return;
    }

    const input = document.getElementById('order_hetzner_server_type');
    const wrap = document.getElementById('order_hetzner_server_type_buttons');
    if (!input || !wrap) return;

    const types = (catalog.server_types || []).filter(function(type) {
      return !!String(type && type.name ? type.name : '');
    }).sort(sortServerTypes);

    if (!types.length) {
      input.value = '';
      wrap.innerHTML = '<div class="small text-muted">No server types available.</div>';
      return;
    }

    const locationName = getSelectedLocationName();
    const grouped = {};
    types.forEach(function(type) {
      const categoryKey = getServerTypeCategory(type.name, type.cpu_type || type.cpuType || '', type.category || '');
      if (!grouped[categoryKey]) grouped[categoryKey] = [];
      grouped[categoryKey].push(type);
    });

    const categoryKeys = Object.keys(grouped).sort(function(a, b) {
      return getServerTypeCategoryMeta(a).order - getServerTypeCategoryMeta(b).order;
    });

    if (!categoryKeys.length) {
      input.value = '';
      wrap.innerHTML = '<div class="small text-muted">No server types available.</div>';
      return;
    }

    const current = String(input.value || cfg.serverType || '').trim();
    const currentType = types.find(function(type) {
      return String(type.name || '') === current;
    }) || null;

    if (categoryKeys.indexOf(selectedServerCategory) === -1) {
      selectedServerCategory = currentType
        ? getServerTypeCategory(currentType.name, currentType.cpu_type || currentType.cpuType || '', currentType.category || '')
        : categoryKeys[0];
    }

    if (categoryKeys.indexOf(selectedServerCategory) === -1) {
      selectedServerCategory = categoryKeys[0];
    }

    function resolveCategoryView(categoryKey) {
      const allTypes = grouped[categoryKey] || [];
      const architectures = collectCategoryArchitectures(allTypes);
      let arch = String(selectedCategoryArchitecture[categoryKey] || '');
      if (architectures.length && architectures.indexOf(arch) === -1) {
        arch = architectures[0];
      }
      if (!architectures.length) {
        arch = '';
      }

      let filtered = allTypes.slice();
      if (arch) {
        filtered = filtered.filter(function(type) {
          return normalizeArchitectureValue(type.architecture || type.architecture_raw || '') === arch;
        });
      }
      if (!filtered.length) {
        filtered = allTypes.slice();
      }

      let active = filtered.filter(function(type) {
        return isServerAvailableInLocation(type, locationName);
      });

      if (!active.length) {
        const activeInCategory = allTypes.filter(function(type) {
          return isServerAvailableInLocation(type, locationName);
        });
        if (activeInCategory.length) {
          const fallbackArch = normalizeArchitectureValue(activeInCategory[0].architecture || activeInCategory[0].architecture_raw || '');
          if (fallbackArch) {
            arch = fallbackArch;
            filtered = allTypes.filter(function(type) {
              return normalizeArchitectureValue(type.architecture || type.architecture_raw || '') === arch;
            });
            if (!filtered.length) {
              filtered = allTypes.slice();
            }
            active = filtered.filter(function(type) {
              return isServerAvailableInLocation(type, locationName);
            });
          } else {
            filtered = allTypes.slice();
            active = activeInCategory;
          }
        }
      }

      selectedCategoryArchitecture[categoryKey] = arch;
      return { allTypes: allTypes, filteredTypes: filtered, activeTypes: active, selectedArch: arch };
    }

    let categoryView = resolveCategoryView(selectedServerCategory);
    if (!categoryView.activeTypes.length) {
      const firstCategoryWithActive = categoryKeys.find(function(key) {
        return resolveCategoryView(key).activeTypes.length > 0;
      });
      if (firstCategoryWithActive) {
        selectedServerCategory = firstCategoryWithActive;
        categoryView = resolveCategoryView(selectedServerCategory);
      }
    }

    const selectedCategoryAllTypes = categoryView.allTypes;
    const selectedCategoryTypes = categoryView.filteredTypes;
    const activeTypes = categoryView.activeTypes;

    let selectedName = '';
    if (
      selectedCategoryTypes.some(function(type) { return String(type.name || '') === current; })
      && activeTypes.some(function(type) { return String(type.name || '') === current; })
    ) {
      selectedName = current;
    } else if (activeTypes.length) {
      selectedName = String(activeTypes[0].name || '');
    } else if (selectedCategoryTypes.length) {
      selectedName = String(selectedCategoryTypes[0].name || '');
    } else {
      selectedName = String(types[0].name || '');
    }
    input.value = selectedName;

    const groupedBySection = {};
    categoryKeys.forEach(function(key) {
      const section = String((getServerTypeCategoryMeta(key) || {}).group || 'other');
      if (!groupedBySection[section]) groupedBySection[section] = [];
      groupedBySection[section].push(key);
    });

    const sectionOrder = ['shared_resources', 'dedicated_resources', 'other'];
    const sectionTitles = {
      shared_resources: 'Shared Resources',
      dedicated_resources: 'Dedicated Resources',
      other: 'Other'
    };

    const chunks = [];
    sectionOrder.forEach(function(section) {
      const keys = groupedBySection[section] || [];
      if (!keys.length) return;

      chunks.push('<div class="order-hetzner-server-type-group-title">' + esc(sectionTitles[section] || section) + '</div>');
      chunks.push('<div class="row g-2 mb-2">');
      keys.forEach(function(key) {
        const meta = getServerTypeCategoryMeta(key);
        const typesInCategory = grouped[key] || [];
        const availableCount = typesInCategory.filter(function(type) {
          return isServerAvailableInLocation(type, locationName);
        }).length;
        const categoryHasActive = availableCount > 0;
        const isActiveCategory = key === selectedServerCategory;
        const architectures = collectCategoryArchitectures(typesInCategory);
        const archSelected = String(selectedCategoryArchitecture[key] || architectures[0] || '');
        selectedCategoryArchitecture[key] = archSelected;

        chunks.push('<div class="col-12 col-lg-4">');
        chunks.push('<div class="order-hetzner-server-type-category-card' + (isActiveCategory ? ' is-selected' : '') + '">');
        const categoryBtnClass = isActiveCategory
          ? 'btn btn-primary'
          : (categoryHasActive ? 'btn btn-outline-secondary' : 'btn btn-outline-secondary disabled opacity-50');
        chunks.push(
          '<button type="button" class="' + categoryBtnClass + ' w-100 text-start order-hetzner-server-category-btn" data-category="' + esc(key) + '" data-active="' + (categoryHasActive ? '1' : '0') + '">'
            + '<div class="fw-semibold">' + esc(meta.title || key) + '</div>'
            + '<div class="small mt-1">' + esc(meta.description || '') + '</div>'
          + '</button>'
        );
        if (availableCount < typesInCategory.length) {
          chunks.push('<div class="mt-2"><span class="badge text-bg-warning">Limited availability</span></div>');
        }
        if (Array.isArray(meta.badges) && meta.badges.length) {
          chunks.push('<div class="d-flex flex-wrap gap-1 mt-2">');
          meta.badges.forEach(function(badge) {
            chunks.push('<span class="badge text-bg-light border">' + esc(badge) + '</span>');
          });
          chunks.push('</div>');
        }
        if (architectures.length) {
          chunks.push('<div class="small text-muted mt-2 mb-1">Architecture</div>');
          chunks.push('<div class="d-flex flex-wrap gap-1">');
          architectures.forEach(function(arch) {
            const archClass = arch === archSelected ? 'btn btn-sm btn-primary' : 'btn btn-sm btn-outline-secondary';
            chunks.push(
              '<button type="button" class="' + archClass + ' order-hetzner-server-architecture-btn" data-category="' + esc(key) + '" data-architecture="' + esc(arch) + '">' + esc(getArchitectureLabel(arch)) + '</button>'
            );
          });
          chunks.push('</div>');
        }
        chunks.push('</div>');
        chunks.push('</div>');
      });
      chunks.push('</div>');
    });

    chunks.push('<div class="small fw-semibold text-muted text-uppercase mt-3 mb-1">Available Servers For The Server Type</div>');
    chunks.push('<div class="order-hetzner-server-type-table-head">');
    chunks.push('<div>Name</div><div>vCPUs</div><div>RAM</div><div>SSD</div><div>Traffic</div><div>Price / h</div><div>Price / mo</div>');
    chunks.push('</div>');

    if (!selectedCategoryTypes.length) {
      chunks.push('<div class="border rounded-bottom p-2 small text-muted">No server types available for this category.</div>');
    } else {
      selectedCategoryTypes.forEach(function(type) {
        const name = String(type.name || '');
        const isAvailable = isServerAvailableInLocation(type, locationName);
        const isSelected = name === selectedName;
        const arch = normalizeArchitectureValue(type.architecture || type.architecture_raw || '');
        const exactRow = findExactLocationPrice(((type.pricing || {}).location_prices || []), locationName);
        const fallbackPair = normalizeRatePair(type.price_hourly_from, type.price_monthly_from);
        const exactPair = exactRow ? normalizeRatePair(exactRow.hourly_gross, exactRow.monthly_gross) : { hourly: null, monthly: null };
        const hourlyText = (exactPair.hourly !== null)
          ? formatPrice(exactPair.hourly, (exactRow && exactRow.currency) || type.price_currency)
          : ((fallbackPair.hourly !== null) ? ('from ' + formatPrice(fallbackPair.hourly, type.price_currency)) : '-');
        const monthlyText = (exactPair.monthly !== null)
          ? formatPrice(exactPair.monthly, (exactRow && exactRow.currency) || type.price_currency)
          : ((fallbackPair.monthly !== null) ? ('from ' + formatPrice(fallbackPair.monthly, type.price_currency)) : '-');
        const trafficBytes = (exactRow && exactRow.included_traffic !== null)
          ? exactRow.included_traffic
          : (type.included_traffic !== null && type.included_traffic !== undefined ? type.included_traffic : null);
        const trafficText = formatIncludedTraffic(trafficBytes);

        const rowClass = 'order-hetzner-server-type-table-row order-hetzner-server-type-btn'
          + (isSelected ? ' is-selected' : '')
          + (isAvailable ? '' : ' is-inactive');

        chunks.push(
          '<button type="button" class="' + rowClass + '" data-server-type="' + esc(name) + '" data-active="' + (isAvailable ? '1' : '0') + '">'
            + '<div class="col-name">' + esc(name)
              + (arch ? ' <span class="badge text-bg-info ms-1">' + esc(getArchitectureLabel(arch)) + '</span>' : '')
              + (isAvailable ? '' : ' <span class="badge text-bg-secondary ms-1">Inactive</span>')
            + '</div>'
            + '<div class="col-meta col-cores">' + esc(String(type.cores || 0)) + '</div>'
            + '<div class="col-meta col-memory">' + esc(String(type.memory || 0)) + ' GB</div>'
            + '<div class="col-meta col-disk">' + esc(String(type.disk || 0)) + ' GB</div>'
            + '<div class="col-meta col-traffic">' + esc(trafficText) + '</div>'
            + '<div class="col-price col-hourly">' + esc(hourlyText) + '</div>'
            + '<div class="col-price col-monthly">' + esc(monthlyText) + '</div>'
          + '</button>'
        );
      });
    }

    wrap.innerHTML = chunks.join('');
    wrap.querySelectorAll('.order-hetzner-server-category-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (String(btn.getAttribute('data-active') || '1') !== '1') return;
        const key = String(btn.getAttribute('data-category') || '');
        if (!key) return;
        if (key === selectedServerCategory) return;
        selectedServerCategory = key;
        const before = String(input.value || '');
        populateServerTypes();
        if (String(input.value || '') !== before) {
          input.dispatchEvent(new Event('change'));
        } else {
          renderTypeHint();
          populateImages();
          renderOptionPricingHints();
          updateBillingSummary();
        }
      });
    });
    wrap.querySelectorAll('.order-hetzner-server-architecture-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        const key = String(btn.getAttribute('data-category') || '');
        const arch = String(btn.getAttribute('data-architecture') || '');
        if (!key || !arch) return;
        if (String(selectedCategoryArchitecture[key] || '') === arch && key === selectedServerCategory) return;
        selectedCategoryArchitecture[key] = arch;
        selectedServerCategory = key;
        const before = String(input.value || '');
        populateServerTypes();
        if (String(input.value || '') !== before) {
          input.dispatchEvent(new Event('change'));
        } else {
          renderTypeHint();
          populateImages();
          renderOptionPricingHints();
          updateBillingSummary();
        }
      });
    });
    wrap.querySelectorAll('.order-hetzner-server-type-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (String(btn.getAttribute('data-active') || '1') !== '1') return;
        const value = String(btn.getAttribute('data-server-type') || '');
        if (!value) return;
        const selectedType = types.find(function(type) {
          return String(type.name || '') === value;
        }) || null;
        if (selectedType) {
          selectedServerCategory = getServerTypeCategory(selectedType.name, selectedType.cpu_type || selectedType.cpuType || '', selectedType.category || '');
          const selectedArchValue = normalizeArchitectureValue(selectedType.architecture || selectedType.architecture_raw || '');
          if (selectedArchValue) {
            selectedCategoryArchitecture[selectedServerCategory] = selectedArchValue;
          }
        }
        input.value = value;
        populateServerTypes();
        input.dispatchEvent(new Event('change'));
      });
    });

    renderTypeHint();
  }

  function populateLocations() {
    if (!cfg.allowLocationChoice) return;

    const input = document.getElementById('order_hetzner_location');
    const buttonsWrap = document.getElementById('order_hetzner_location_buttons');
    if (!input || !buttonsWrap) return;

    const rows = [];
    (catalog.locations || []).forEach(function(location) {
      const name = String(location.name || '');
      if (!name) return;
      rows.push(location);
    });

    rows.sort(function(a, b) {
      return String(a.name || '').localeCompare(String(b.name || ''));
    });

    const type = getSelectedType();
    const current = String(input.value || cfg.location || '').trim();
    let selectedName = '';
    if (rows.some(function(row) {
      return String(row.name || '') === current && isServerAvailableInLocation(type, String(row.name || ''));
    })) {
      selectedName = current;
    } else {
      const firstActive = rows.find(function(row) {
        return isServerAvailableInLocation(type, String(row.name || ''));
      });
      selectedName = firstActive ? String(firstActive.name || '') : (rows.length ? String(rows[0].name || '') : '');
    }
    input.value = selectedName;

    if (!rows.length) {
      buttonsWrap.innerHTML = '<div class="small text-muted">No locations returned in catalog.</div>';
      return;
    }

    const cards = [];
    rows.forEach(function(location) {
      const name = String(location.name || '');
      const isAvailable = isServerAvailableInLocation(type, name);
      const title = name + (location.city ? (' (' + location.city + ')') : '');
      const countryCode = normalizeCountryCode(location.country);
      const flagSvg = getFlagSvg(countryCode);
      const priceRow = findExactLocationPrice(((type && type.pricing ? type.pricing.location_prices : []) || []), name);
      const pair = priceRow ? normalizeRatePair(priceRow.hourly_gross, priceRow.monthly_gross) : { hourly: null, monthly: null };
      const priceText = (pair.hourly !== null || pair.monthly !== null)
        ? (formatPrice(pair.hourly, (priceRow && priceRow.currency) || (type ? type.price_currency : 'EUR')) + ' hourly / ' + formatPrice(pair.monthly, (priceRow && priceRow.currency) || (type ? type.price_currency : 'EUR')) + ' monthly')
        : (isAvailable ? 'Pricing unavailable' : 'Unavailable for selected server');
      const isSelected = name === selectedName;
      const btnClass = isSelected
        ? (isAvailable ? 'btn btn-primary text-start' : 'btn btn-secondary text-start')
        : (isAvailable ? 'btn btn-outline-secondary text-start' : 'btn btn-outline-secondary text-start disabled opacity-50');
      cards.push(
        '<button type="button" class="' + btnClass + ' order-hetzner-location-btn" data-location="' + esc(name) + '" data-active="' + (isAvailable ? '1' : '0') + '" style="min-width: 220px;">'
          + '<div class="d-flex align-items-center gap-2">'
            + '<span class="d-inline-flex border rounded" style="overflow:hidden;line-height:0;" title="' + esc(countryCode || 'N/A') + '">' + flagSvg + '</span>'
            + '<div class="fw-semibold">' + esc(title) + (isAvailable ? '' : ' <span class="badge bg-secondary ms-1">Inactive</span>') + '</div>'
          + '</div>'
          + '<div class="small">' + esc(priceText) + '</div>'
        + '</button>'
      );
    });

    buttonsWrap.innerHTML = cards.join('');
    buttonsWrap.querySelectorAll('.order-hetzner-location-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        if (String(btn.getAttribute('data-active') || '1') !== '1') return;
        const value = String(btn.getAttribute('data-location') || '');
        if (!value) return;
        input.value = value;
        populateLocations();
        input.dispatchEvent(new Event('change'));
      });
    });
  }

  function populateImages() {
    if (!cfg.allowImageChoice) return;

    const el = document.getElementById('order_hetzner_image');
    if (!el) return;

    const type = getSelectedType();
    const typeArch = normalizeArchitectureValue(type && type.architecture ? String(type.architecture) : '');
    const allImages = Array.isArray(catalog.images) ? catalog.images : [];
    const compatible = allImages.filter(function(image) {
      const arch = normalizeArchitectureValue(String((image || {}).architecture || (image || {}).architecture_raw || ''));
      if (!typeArch || !arch) return true;
      return arch === typeArch;
    });
    const source = compatible.length ? compatible : allImages;

    const current = String(el.value || '').trim();
    const defaultImage = String(cfg.image || '').trim();
    let selectedName = '';
    if (source.some(function(image) { return String((image || {}).name || '') === current; })) {
      selectedName = current;
    } else if (source.some(function(image) { return String((image || {}).name || '') === defaultImage; })) {
      selectedName = defaultImage;
    } else {
      const first = source.find(function(image) { return !!String((image || {}).name || ''); }) || null;
      selectedName = first ? String(first.name || '') : '';
    }

    const options = ['<option value="">Select image</option>'];
    source.forEach(function(image) {
      const name = String((image || {}).name || '');
      if (!name) return;
      const selected = selectedName === name ? ' selected' : '';
      options.push('<option value="' + esc(name) + '"' + selected + '>' + esc(name + ((image && image.description) ? ' | ' + image.description : '')) + '</option>');
    });

    el.innerHTML = options.join('');
    if (selectedName) {
      el.value = selectedName;
    }
  }

  function populateFirewalls() {
    if (cfg.firewallMode !== 'customer') return;

    const el = document.getElementById('order_hetzner_firewall_ids');
    if (!el) return;

    const allowed = parseIdList(cfg.firewallIds);
    const defaults = parseIdList(cfg.firewallDefaultIds);

    const options = [];
    (catalog.firewalls || []).forEach(function(fw) {
      const id = parseInt(fw.id, 10);
      if (!id) return;
      if (allowed.length && allowed.indexOf(id) === -1) return;
      const selected = defaults.indexOf(id) !== -1 ? ' selected' : '';
      options.push('<option value="' + id + '"' + selected + '>' + esc(id + ' - ' + (fw.name || 'Firewall')) + '</option>');
    });

    el.innerHTML = options.join('');
  }

  function refreshDependent() {
    populateServerTypes();
    populateLocations();
    populateServerTypes();
    renderTypeHint();
    populateImages();
    renderOptionPricingHints();
    syncMappedAddons();
  }

  function loadCatalog() {
    API.guest.post('servicehetzner/catalog_get', { refresh: '1', project_ref: cfg.projectRef || '' }, function(result) {
      if (result && result.ok === false) {
        FOSSBilling.message(result.message || 'Failed to load Hetzner catalog', 'error');
        return;
      }

      catalog = (result && result.catalog) ? result.catalog : { server_types: [], locations: [], images: [], firewalls: [], option_pricing: {} };
      refreshDependent();
      populateFirewalls();
      renderOptionPricingHints();
      syncMappedAddons();
      updateBillingSummary();
    }, function(result) {
      FOSSBilling.message((result && result.message) || 'Failed to load Hetzner catalog', 'error');
    });
  }

  document.addEventListener('DOMContentLoaded', function() {
    syncPrepaidHoursQuantity();
    syncMappedAddons();
    updateBillingSummary();

    API.guest.post('cart/get_currency', {}, function(result) {
      if (result && result.code) {
        billingCurrencyCode = String(result.code);
      }
      updateBillingSummary();
    });

    loadCatalog();

    const serverType = document.getElementById('order_hetzner_server_type');
    if (serverType) {
      serverType.addEventListener('change', refreshDependent);
    }

    const location = document.getElementById('order_hetzner_location');
    if (location) {
      location.addEventListener('change', function() {
        refreshDependent();
      });
    }

    const serverTypeInput = document.getElementById('order_hetzner_server_type');
    const locationInput = document.getElementById('order_hetzner_location');
    const orderForm = locationInput ? locationInput.closest('form') : null;
    if (orderForm) {
      orderForm.addEventListener('submit', function(ev) {
        if (cfg.allowServerTypeChoice && serverTypeInput && !String(serverTypeInput.value || '').trim()) {
          ev.preventDefault();
          FOSSBilling.message('Please select a server type.', 'error');
          return;
        }
        if (cfg.allowLocationChoice && !String(locationInput.value || '').trim()) {
          ev.preventDefault();
          FOSSBilling.message('Please select a location.', 'error');
          return;
        }
        const selectedType = getSelectedType();
        const selectedLocation = getSelectedLocationName();
        if (cfg.allowServerTypeChoice && cfg.allowLocationChoice && selectedType && selectedLocation && !isServerAvailableInLocation(selectedType, selectedLocation)) {
          ev.preventDefault();
          FOSSBilling.message('Selected server type is not available in the selected location.', 'error');
        }
      });
    }

    const period = document.getElementById('order_hetzner_period');
    if (period) {
      period.addEventListener('change', updateBillingSummary);
    }

    const prepaidHours = document.getElementById('order_hetzner_prepaid_hours');
    if (prepaidHours) {
      ['input', 'change'].forEach(function(ev) {
        prepaidHours.addEventListener(ev, function() {
          syncPrepaidHoursQuantity();
          updateBillingSummary();
        });
      });
    }

    ['order_hetzner_ipv4', 'order_hetzner_ipv6', 'order_hetzner_backups'].forEach(function(id) {
      const el = document.getElementById(id);
      if (el) {
        el.addEventListener('change', syncMappedAddons);
      }
    });

    const firewall = document.getElementById('order_hetzner_firewall_ids');
    if (firewall) {
      firewall.addEventListener('change', syncMappedAddons);
    }

    document.querySelectorAll('input[name^="addons["][name$="[selected]"]').forEach(function(el) {
      el.addEventListener('change', updateBillingSummary);
    });
    document.querySelectorAll('select[name^="addons["][name$="[period]"]').forEach(function(el) {
      el.addEventListener('change', updateBillingSummary);
    });
  });
})();
</script>
